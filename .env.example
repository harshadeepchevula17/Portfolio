# Frontend origin used by the server for CORS checks.
# Match the exact port the Vite app is running on; in this session Vite selected 8082.
FRONTEND_URL=http://localhost:8082

# Relative URL keeps the contact form working on the same origin during local development.
VITE_API_URL=/api/contact

# Gmail SMTP configuration for the contact form.
# An app password is usually 16 characters and must not include spaces.
MAIL_USER=your-email@gmail.com
MAIL_APP_PASSWORD=abcdefghijklmnop
MAIL_TO=your-recipient@example.com
